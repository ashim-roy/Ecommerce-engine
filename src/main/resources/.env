# ==========================================
# Database Configuration, using same DB for user service and product service
# ==========================================
DB_URL=jdbc:mysql://localhost:3306/productservice
DB_USERNAME=productService26User
# DB_PASSWORD=

# ==========================================
# Server
# ==========================================
SERVER_PORT=9000

# ==========================================
# Spring Security
# ==========================================
SPRING_SECURITY_USERNAME=user
SPRING_SECURITY_PASSWORD=password

# ==========================================
# Logging
# ==========================================
WEB_LOG_LEVEL=TRACE
SECURITY_LOG_LEVEL=TRACE

# ==========================================
# JPA
# ==========================================
JPA_SHOW_SQL=true
DDL_AUTO=update
FLYWAY_BASELINE_ON_MIGRATE=true